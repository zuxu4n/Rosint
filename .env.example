# Copy to .env and fill in. .env is gitignored; this template is not.
# Search needs no secrets. AI keys below are only for local triage scripts.

# Primary provider — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback — Cloudflare Workers AI
# Not named CF_*: Wrangler would read those from .env as deploy credentials.
TRIAGE_CF_ACCOUNT_ID=
TRIAGE_CF_API_TOKEN=

# Optional model overrides
# GEMINI_MODEL=gemini-3.6-flash
# CF_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional local removal service for dynamic restriction checks.
# VITE_REMOVAL_SERVICE_ORIGIN=http://127.0.0.1:5174
