# Copy to .env and fill in. .env is gitignored; this template is not.
# Used only by scripts/triage.mjs (the site itself needs no keys).

# Primary provider — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional fallback — Cloudflare Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Unused unless askGemini is wired back in — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides
# CLAUDE_MODEL=claude-opus-5
# CF_MODEL=@cf/meta/llama-3.1-8b-instruct
# GEMINI_MODEL=gemini-3.6-flash
